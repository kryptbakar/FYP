# =====================================================================
# SOC Central — environment template.
# Copy to `.env` (gitignored) and fill in real values for local dev.
# In the K3s phase these move to HashiCorp Vault. NEVER commit `.env`.
# =====================================================================

# ---- General ----
SOC_ENV=development
SOC_VERSION=1.0.0

# ---- PostgreSQL (transactional state) ----
POSTGRES_HOST=postgres
# Host-published port. Internal service-to-service traffic uses POSTGRES_PORT_INTERNAL
# (the in-container port, always 5432) so it's independent of the host mapping.
POSTGRES_PORT=5432
POSTGRES_PORT_INTERNAL=5432
POSTGRES_DB=soc_central
POSTGRES_USER=soc
POSTGRES_PASSWORD=change_me_postgres

# ---- TimescaleDB (time-series telemetry) ----
TIMESCALE_HOST=timescaledb
# Host-published port. 5433 to avoid clashing with PostgreSQL's 5432 on the host.
# (Internal service-to-service traffic still uses 5432 over the compose network.)
TIMESCALE_PORT=5433
TIMESCALE_DB=soc_telemetry
TIMESCALE_USER=soc
TIMESCALE_PASSWORD=change_me_timescale

# ---- OpenSearch (full-text / log search) ----
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http
# OpenSearch 2.12+ requires a strong initial admin password.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Change_me_OpenSearch_1!

# ---- NATS JetStream (message broker) ----
NATS_HOST=nats
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://nats:4222

# ---- API service ----
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
# Authentication enforcement. Off here so the local demo is frictionless; set to true
# for any shared/staging deploy. It is FORCED on whenever SOC_ENV=production, regardless
# of this value. When on: every non-public route needs a principal (oauth2-proxy header
# or a local session token) and RBAC gates writes/response. See docs/THREAT-MODEL.md TB2.
API_AUTH_REQUIRED=false

# ---- Grafana (presentation) ----
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# ---- Analyst console (presentation) ----
CONSOLE_PORT=3001

# ---- Ingestion backbone (Phase 1) ----
# ingest-edge mTLS telemetry listener (host-published port).
INGEST_PORT=8443
# Shared bearer token agents present alongside their mTLS client cert.
INGEST_AGENT_TOKEN=change_me_agent_token
# Per-agent ingest rate limit (token bucket, keyed by mTLS CN). 0 disables.
# Over-quota requests get HTTP 429. Sized for a normal agent's steady + burst rate.
INGEST_RATE_PER_SEC=200
INGEST_RATE_BURST=400
# Set >0 (ms) to artificially slow workers and demonstrate broker back-pressure.
WORKER_SLOW_MS=0

# ---- Feed sync (the ONLY internet-facing job; used from Phase 3) ----
# Request a free key at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
EPSS_CSV_URL=https://epss.cyentia.com/epss_scores-current.csv.gz
KEV_JSON_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# ---- Automation engine (n8n; see docs/N8N-AUTOMATION.md) ----
# Self-hosted, all internal. Paste an n8n API key (n8n -> Settings -> n8n API -> Create) to light up
# LIVE execution status in the console's Automation view. Left blank, it shows VYREX-side activity.
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=
# Optional chat fan-out: a self-hosted Mattermost/Slack/Rocket.Chat *incoming webhook* URL the
# alert-intake workflow POSTs to. Leave blank to disable (the node continues on error).
CHAT_WEBHOOK_URL=

# ---- Self-hosted LLM (Ollama; see docs/AGENT-ORCHESTRATION.md) ----
# Air-gapped by design: the weights travel in the offline bundle as the vyrex_ollamadata
# volume, and a sealed install never pulls. Used by BOTH the deprecated /agent/* routes and
# the investigation orchestrator, so changing the model here changes both.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
# Generation timeouts in seconds. These matter more than they look: CPU-only inference
# varies by an order of magnitude with model size. Measured on a 16 GB laptop with 5.8 GiB
# to Docker, 3B models take 45-110 s per synthesis, while qwen3:4b did not finish a single
# response in 900 s at 3.2 tok/s. If you change OLLAMA_MODEL, re-check these.
OLLAMA_TRIAGE_TIMEOUT_S=180
OLLAMA_INVESTIGATE_TIMEOUT_S=240
# Orchestrator-side equivalents (docker-compose.yml, --profile agentic).
ORCH_LLM_TIMEOUT_S=240
ORCH_POLL_INTERVAL_S=5
# Serial by default: two concurrent 3B generations is where a 5.8 GiB Docker VM swaps.
ORCH_CONCURRENCY=1
# ---- Least-privilege DB role for the orchestrator ----
# The orchestrator feeds untrusted evidence to an LLM, and docs/THREAT-MODEL.md §3.1 shows
# a working prompt injection against it, so it is the service that must not hold write
# access to response_actions. Set a password here and the API creates the
# `vyrex_orchestrator` role at startup and the orchestrator authenticates as it; leave it
# blank and the orchestrator keeps using the shared superuser (the pre-2026-08-28
# behaviour). STRONGLY recommended in any deployment you would call production.
ORCH_DB_POSTGRES_USER=vyrex_orchestrator
ORCH_DB_POSTGRES_PASSWORD=
